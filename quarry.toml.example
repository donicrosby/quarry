# quarry.toml.example
# Copy to quarry.toml and edit as needed.
# Never store API keys or secrets in this file.

# --------------------------------------------------------------------------
# Authentication profiles (optional)
# Copy examples/auth-profiles.toml.example to auth-profiles.toml, fill in
# env-var names, and point auth_config_ref at the live file.
# auth-profiles.toml is gitignored -- never commit secret env-var values.
# --------------------------------------------------------------------------
# auth_config_ref = "examples/auth-profiles.toml"

# --------------------------------------------------------------------------
# Vulnerability class focus (optional)
# Omit or leave empty to scan all classes.
# --------------------------------------------------------------------------
# [scan_defaults]
# focus_classes = ["ssrf", "xss"]
# hunt_max_iterations = 12       # tool-call iterations per hunter agent (default: 12)
# hunt_max_concurrent = 8        # maximum hunters running in parallel (default: 8)
# validate_max_iterations = 20   # iterations per validator agent (default: 20)
# gapfill_max_iterations = 20    # iterations for the gapfill coverage agent (default: 20)
# recon_max_iterations = 40      # iterations for the recon subsystem agent (default: 40)
# dedup_max_iterations = 8       # iterations per dedup cluster agent (default: 8)
# max_coverage_rounds = 3        # cap on iterative-coverage-loop rounds (default: 3)
#
# Stage fan-out bounds (scan-stage-fanout; prove added in cruft-purge 3.2).
# A higher value increases parallelism but not total model invocations.
# prove_max_concurrent = 4       # concurrent per-finding PROVE attempt loops (default: 4)
#
# Rising-bar early stop (ADR-022). A round must add at least
#   max(1, ceil(coverage_yield_threshold * findings_so_far))
# new distinct findings to justify another round, so the bar climbs as findings
# accumulate and the loop stops once rounds stop paying off. This trades recall
# for cost by design: lower it to be more patient (higher recall, more rounds),
# raise it to stop sooner. Set it to 0.0 to disable the rule entirely for an
# exhaustive audit, leaving only convergence / round cap / budget as stop
# criteria. The rule can only ever stop the loop *earlier*, never extend it.
# coverage_yield_threshold = 0.15
#
# Unconstrained exploratory-investigation injection: the fraction of each
# gapfill pass deliberately spent on open-ended "explore this area"
# investigations with no vulnerability class and no threat-model context —
# a hedge against tunnel vision from the threat model. Bounded to the 25–50%
# band; 0.0 disables the injection entirely.
# exploratory_injection_fraction = 0.3
# seed = 42                      # fix model seed for reproducible runs (omit to derive from scan ID)
#
# Vendor allowlist (optional). Fail fast before any model call if a panel names a
# provider outside this set — a guardrail against accidentally sending target code
# to an unapproved vendor. Empty or omitted means unrestricted. Values match the
# provider names below ("anthropic", "bedrock", "litellm", ...).
# vendor_allowlist = ["anthropic", "bedrock"]

# --------------------------------------------------------------------------
# Model panels
# Define named panels that override the built-in defaults role-by-role.
# Any role not listed falls back to the DEFAULT_PANEL (mock provider).
#
# A role is single-model by default (one provider/model). It behaves as an
# implicit single "reasoner" tier, so existing single-model configs keep working.
#
# Provider is one of "mock", "litellm", or "bedrock". LiteLLM routes to any vendor
# via a "/"-prefixed model string (e.g. "anthropic/claude-3-5-sonnet-20241022");
# Bedrock takes a bare Bedrock model id and prefixes "bedrock/" itself.
#
# Rate limiting: each role/tier takes an `rpm` (requests per minute). Calls are
# smoothed through a per-(provider, role) token bucket in the dispatch path, so a
# burst is throttled to the limit rather than rejected. Omit rpm (or set 0) to run
# unthrottled. Rate limiting lives outside workflow code and is replay-safe.
# --------------------------------------------------------------------------

# [panels.oss.roles.recon]
# provider = "litellm"
# model = "anthropic/claude-3-haiku-20240307"
# rpm = 10
#
# [panels.oss.roles.hunt]
# provider = "litellm"
# model = "anthropic/claude-3-5-sonnet-20241022"
# rpm = 5

# --------------------------------------------------------------------------
# Tiered panel (MDASH ensemble)
# A role MAY instead declare an ordered set of tiers instead of a single model:
#   - reasoner:    the SOTA heavy-reasoning pass (required; the primary verdict).
#   - debater:     a cheaper, independent model that argues to *refute* the
#                  candidate from the code (distinct `prompt_regime = "refute"`).
#   - counterpoint: an optional second independent SOTA model.
# Cross-model (dis)agreement becomes an ordinal credibility signal on the finding
# — refuted / contested / unrefuted — rather than a discarded boolean. A debater
# that tries and fails to refute *raises* credibility; it never emits new findings
# and a finding is never silently dropped on credibility alone. The report surfaces
# the credibility and each contributing judgement, traceable to its invocation.
# Use a different vendor for the debater to get genuine independence.
# --------------------------------------------------------------------------

# [[panels.ensemble.roles.validate.tiers]]
# kind = "reasoner"
# provider = "litellm"
# model = "anthropic/claude-3-5-sonnet-20241022"
# rpm = 5
#
# [[panels.ensemble.roles.validate.tiers]]
# kind = "debater"
# provider = "bedrock"
# model = "anthropic.claude-3-haiku-20240307-v1:0"
# prompt_regime = "refute"
# rpm = 10

# [panels.bedrock.roles.recon]
# provider = "bedrock"
# model = "anthropic.claude-3-haiku-20240307-v1:0"
# rpm = 10
#
# [panels.bedrock.roles.hunt]
# provider = "bedrock"
# model = "anthropic.claude-3-5-sonnet-20241022-v2:0"
# rpm = 5

# [panels.benchmark.roles.recon]
# provider = "litellm"
# model = "anthropic/claude-3-opus-20240229"
# rpm = 3
#
# [panels.benchmark.roles.hunt]
# provider = "litellm"
# model = "anthropic/claude-3-opus-20240229"
# rpm = 3

# --------------------------------------------------------------------------
# Budget limits (optional)
# --------------------------------------------------------------------------
# [budget]
# max_cost_per_scan_usd = 5.0
# max_tokens_per_scan = 500000

# --------------------------------------------------------------------------
# Retry policy (optional)
# max_attempts counts the initial try plus retries per activity (Temporal
# semantics); 3-5 recommended. The interval knobs are seconds-scale by default
# (cruft-purge 3.7): retries back off exponentially from initial_interval_seconds
# up to maximum_interval_seconds, with jitter_fraction (0.0-0.5) spreading
# concurrent workers' retries so they don't re-stampede a cold provider.
# calibrate_start_to_close_seconds is the per-attempt StartToClose budget for
# the calibrate-finding agent loop (default 300s covers 10 turns at observed
# chutes latency; the 2026-09-26 baseline scan failed a 61s attempt budget
# during an OOM window).
# --------------------------------------------------------------------------
# [retry]
# max_attempts = 4
# initial_interval_seconds = 2.0
# backoff_coefficient = 2.0
# maximum_interval_seconds = 30.0
# jitter_fraction = 0.2
# calibrate_start_to_close_seconds = 300

# --------------------------------------------------------------------------
# Reasoning lexicon overrides (optional)
# Extend the vagueness guard with phrases specific to your codebase or org.
# Keep entries short and generic — phrases that appear only in vague reasoning
# and never in specific reasoning. Wrong entries silently reject valid actions.
# --------------------------------------------------------------------------
# [scan.reasoning_lexicon]
# banned_phrases = ["just try it", "run the scan", "look at the code"]
# banned_evidence = ["seems vulnerable", "might work"]
