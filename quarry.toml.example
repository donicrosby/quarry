# quarry.toml.example
# Copy to quarry.toml and edit as needed.
# Never store API keys or secrets in this file.

# --------------------------------------------------------------------------
# Vulnerability class focus (optional)
# Omit or leave empty to scan all classes.
# --------------------------------------------------------------------------
# [scan_defaults]
# focus_classes = ["ssrf", "xss"]
# hunt_max_iterations = 12       # tool-call iterations per hunter agent (default: 12)
# hunt_max_concurrent = 8        # maximum hunters running in parallel (default: 8)
# validate_max_iterations = 20   # iterations per validator agent (default: 20)
# gapfill_max_iterations = 20    # iterations for the gapfill coverage agent (default: 20)
# recon_max_iterations = 40      # iterations for the recon subsystem agent (default: 40)
# dedup_max_iterations = 8       # iterations per dedup cluster agent (default: 8)
# seed = 42                      # fix model seed for reproducible runs (omit to derive from scan ID)

# --------------------------------------------------------------------------
# Model panels
# Define named panels that override the built-in defaults role-by-role.
# Any role not listed falls back to the DEFAULT_PANEL (mock provider).
# --------------------------------------------------------------------------

# [panels.oss.roles.recon]
# provider = "anthropic"
# model = "claude-3-haiku-20240307"
# rpm = 10
#
# [panels.oss.roles.hunt]
# provider = "anthropic"
# model = "claude-3-5-sonnet-20241022"
# rpm = 5

# [panels.bedrock.roles.recon]
# provider = "bedrock"
# model = "anthropic.claude-3-haiku-20240307-v1:0"
# rpm = 10
#
# [panels.bedrock.roles.hunt]
# provider = "bedrock"
# model = "anthropic.claude-3-5-sonnet-20241022-v2:0"
# rpm = 5

# [panels.benchmark.roles.recon]
# provider = "anthropic"
# model = "claude-3-opus-20240229"
# rpm = 3
#
# [panels.benchmark.roles.hunt]
# provider = "anthropic"
# model = "claude-3-opus-20240229"
# rpm = 3

# --------------------------------------------------------------------------
# Budget limits (optional)
# --------------------------------------------------------------------------
# [budget]
# max_cost_per_scan_usd = 5.0
# max_tokens_per_scan = 500000

# --------------------------------------------------------------------------
# Reasoning lexicon overrides (optional)
# Extend the vagueness guard with phrases specific to your codebase or org.
# Keep entries short and generic — phrases that appear only in vague reasoning
# and never in specific reasoning. Wrong entries silently reject valid actions.
# --------------------------------------------------------------------------
# [scan.reasoning_lexicon]
# banned_phrases = ["just try it", "run the scan", "look at the code"]
# banned_evidence = ["seems vulnerable", "might work"]
