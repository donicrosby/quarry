# Copy to .env and fill in as needed: `docker compose` reads it automatically.
# These are passed through to the worker container (see docker-compose.yml).

# Named model panel from quarry.toml (e.g. "chutes"). Empty = built-in mock panel.
QUARRY_PANEL=

# Chutes API key — required when QUARRY_PANEL drives litellm/Chutes models.
CHUTES_API_KEY=

# Git auth for cloning private repos (clone activity). Either works for HTTPS;
# SSH (git@) URLs use the host's SSH agent/keys instead.
GITHUB_TOKEN=
GIT_CLONE_TOKEN=
